# Valores por defecto funcionales: copiando este fichero a .env la aplicación
# arranca sin tocar nada. Ninguna de las dos APIs externas requiere credenciales.

DATABASE_URL="file:./prisma/dev.db"

PORT=3000
NODE_ENV=development

# Secreto de firma de sesión. El valor de desarrollo es público a propósito:
# en producción debe sustituirse por uno generado (ver README).
JWT_SECRET="dev-only-insecure-secret-change-in-production"
JWT_EXPIRES_IN="7d"

SPACEX_API_URL="https://api.spacexdata.com/v4"
REST_COUNTRIES_API_URL="https://restcountries.com/v3.1"

# Resiliencia de las llamadas salientes (ADR-005).
EXTERNAL_TIMEOUT_MS=10000
EXTERNAL_MAX_RETRIES=3
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_MS=60000

# Sincronización programada. Desactivada por defecto para que el primer arranque
# sea inmediato y funcione sin conexión: la base ya viene sembrada con fixtures.
# Ponlo a true para traer datos reales de SpaceX y REST Countries.
SYNC_ENABLED=false
SYNC_UPCOMING_CRON="*/15 * * * *"
SYNC_HISTORY_CRON="0 3 * * *"
SYNC_COUNTRIES_CRON="0 4 1 * *"
